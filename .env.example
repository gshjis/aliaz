# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aliaz
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aliaz

# Приложение
APP_NAME=aliaz
APP_VERSION=0.1.0
DEBUG=false

# Сервер
HOST=0.0.0.0
PORT=8000

# Разрешённые хосты (TrustedHostMiddleware). В формате JSON-списка.
# В продакшене укажите реальный домен, например: "your-domain.example.com"
ALLOWED_HOSTS=["localhost", "127.0.0.1", "gshjis.org"]

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1